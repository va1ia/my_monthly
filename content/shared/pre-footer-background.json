{
  "triggerLine": 1,
  "triggerOffsetPx": 80,
  "transitionMs": 2000,
  "returnTransitionMs": 700,
  "default": {
    "colorToken": "--color-picnic-date"
  },
  "sections": [
    {
      "selector": ".contact-faq",
      "media": "(min-width: 768px)",
      "triggerLine": 0.5,
      "triggerOffsetPx": 0,
      "colorToken": "--color-darker-linen"
    },
    {
      "selector": ".contact-faq__item:nth-child(2) > summary",
      "media": "(max-width: 767px)",
      "colorToken": "--color-darker-linen",
      "triggerOffsetPx": 0,
      "preserveOnLayoutChange": true
    }
  ]
}
